# Master (source) videos are large and stay on disk only. The site
# serves the web-optimised, faststart copies in assets/videos/web/,
# which are tracked. Design stills in assets/images/ are tracked.
assets/videos/*
!assets/videos/web/
!assets/videos/web/*.mp4
!assets/videos/.gitkeep